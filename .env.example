# ==============================================================================
# MessMate Environment Variables Template (.env.example) - Zero-Budget Edition
# IMPORTANT: All secrets live on the server-side only. Never expose to client.
# ==============================================================================

# Database connection string (PostgreSQL - Supabase Pooled Connection)
DATABASE_URL="postgresql://postgres.xxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Scheduler Cron Secret for protected /api/cron/tick endpoint authorization
# Configured in cron-job.org as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your_secure_32_character_cron_secret"

# Session Secret for signed, tamper-proof httpOnly session cookies
SESSION_SECRET="your_random_32_character_session_secret"

# Initial Seed Credentials (used by seed script to initialize DB)
# Once seeded, the mess phone and passcode can be managed in the Settings UI / DB.
MESS_PHONE="+91XXXXXXXXXX"
SEED_PASSCODE="your_group_passcode"

# Web Push Notifications (VAPID Keys generated via: npm run vapid:generate)
VAPID_PUBLIC_KEY="your_vapid_public_key_here"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:admin@example.com"

# App Public Domain (for PWA base references)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
